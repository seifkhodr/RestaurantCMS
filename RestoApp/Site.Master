<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="RestoApp.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server"></asp:ContentPlaceHolder> - RestoApp</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- AOS scroll animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
    <link href="~/Content/css/modern-theme.css?v=20260519-lux2" rel="stylesheet" runat="server" />
</head>
<body class="d-flex flex-column min-vh-100">
    <form id="form1" runat="server" class="d-flex flex-column flex-grow-1">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="~/Default.aspx" runat="server"><i class="fa-solid fa-utensils"></i> RestoApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <asp:PlaceHolder ID="phClientLinks" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" href="~/Default.aspx" runat="server">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/ClientsView/Menu/Menu.aspx" runat="server">Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/ClientsView/tables/Tables.aspx" runat="server">Reserve a Table</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/ClientsView/Feedbacks/Reviews.aspx" runat="server">Reviews</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" href="~/ClientsView/Cart/Cart.aspx" runat="server">
                                    <i class="fa-solid fa-cart-shopping"></i> Cart (<%= RestoApp.CartManager.GetTotalCount() %>)
                                </a>
                            </li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phAdminLinks" runat="server" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Dashboard/AdminDashboard.aspx" runat="server">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Users/AdminUsers.aspx" runat="server">Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Menus/AdminMenus.aspx" runat="server">Menus</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Items/AdminItems.aspx" runat="server">Items</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Tables/AdminTables.aspx" runat="server">Tables</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Reservations/AdminReservations.aspx" runat="server">Reservations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="~/AdminView/Feedbacks/AdminFeedbacks.aspx" runat="server">Reviews</a>
                            </li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phGuest" runat="server">
                            <li class="nav-item">
                                <a class="nav-link btn btn-primary text-white ms-3 px-3" href="~/Authentication/Login.aspx" runat="server">Login</a>
                            </li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phUser" runat="server" Visible="false">
                            <li class="nav-item d-flex align-items-center ms-3">
                                <span class="nav-link text-light me-2 pe-pointer">
                                    <i class="fa-regular fa-circle-user mb-1"></i> <asp:Literal ID="litUserName" runat="server"></asp:Literal>
                                </span>
                                <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-danger btn-sm" OnClick="btnLogout_Click" CausesValidation="false">Logout</asp:LinkButton>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="footer mt-auto">
            <div class="container">
                <span>&copy; <%: DateTime.Now.Year %> RestoApp. All rights reserved.</span>
            </div>
        </footer>

        <!-- Bootstrap Bundle with Popper -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <!-- AOS scroll animation JS -->
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
        <script src='<%= ResolveUrl("~/Content/js/luxury-animations.js") %>?v=20260519-lux2'></script>
    </form>
</body>
</html>
